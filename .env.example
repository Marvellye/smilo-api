APP_NAME=Smilo API
APP_ENV=local
APP_DEBUG=true
APP_PORT=8000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Public URL of the frontend — used to build password-reset links
SITE_URL=http://localhost:5173

# Database driver: "mysql" or "sqlite"
DB_DRIVER=mysql

# MySQL settings (used when DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smilo
DB_USER=root
DB_PASS=

# SQLite settings (used when DB_DRIVER=sqlite)
DB_SQLITE_PATH=storage/database/smilo.db

# JWT (min 32 chars for HS256)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY=86400

# Password reset tokens (seconds)
RESET_TOKEN_TTL=3600

# --- Outbound email ---
# Leave SMTP_HOST blank in local dev: emails are written to
# storage/logs/mail.log and the reset link is returned in the API response
# while APP_DEBUG=true. Set it to send real mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "tls" (STARTTLS, port 587) or "ssl" (implicit, port 465)
SMTP_SECURE=tls
# Set to false only for a self-signed mail server
SMTP_VERIFY_PEER=true
MAIL_FROM=no-reply@smilo.ng
MAIL_FROM_NAME=Smilo Marketplace
